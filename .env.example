# --- Site -------------------------------------------------------------------------------------
# Canonical site URL (canonical links, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://insilicology.com

# --- Supabase (leave unset to run on sample data) ----------------------------------------------
# Project Settings > API. The publishable key (older projects: "anon" key) is safe to expose;
# row-level security decides what it can do.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET. Server-side only (Vercel env var, never NEXT_PUBLIC_). Bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the database webhook that refreshes public pages when content is approved.
# Any long random string, e.g. `openssl rand -hex 32`.
REVALIDATE_SECRET=

# --- Contact form (all optional) ---------------------------------------------------------------
# Shown on the contact page when the form is not connected
NEXT_PUBLIC_CONTACT_EMAIL=
# Cloudflare Turnstile captcha. Both keys, or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Secret used to hash sender IPs for rate limiting (defaults to the service key)
CONTACT_HASH_SECRET=
# Email yourself each message through Resend
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL=
