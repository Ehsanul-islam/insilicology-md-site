{
  "name": "insilicology-md-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "node --experimental-strip-types --no-warnings scripts/gen-seed.ts",
